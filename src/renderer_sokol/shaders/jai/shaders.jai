        desc.samplers[7].msl_sampler_n = 0;
        desc.samplers[8].stage = .FRAGMENT;
        desc.samplers[8].sampler_type = .FILTERING;
        desc.samplers[8].msl_sampler_n = 1;
        desc.image_sampler_pairs[0].stage = .FRAGMENT;
        desc.image_sampler_pairs[0].image_slot = 1;
        desc.image_sampler_pairs[0].sampler_slot = 1;
        desc.image_sampler_pairs[1].stage = .FRAGMENT;
        desc.image_sampler_pairs[1].image_slot = 0;
        desc.image_sampler_pairs[1].sampler_slot = 0;
        desc.image_sampler_pairs[2].stage = .FRAGMENT;
        desc.image_sampler_pairs[2].image_slot = 7;
        desc.image_sampler_pairs[2].sampler_slot = 7;
        desc.image_sampler_pairs[3].stage = .FRAGMENT;
